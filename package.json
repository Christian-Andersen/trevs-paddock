{
  "name": "trevs-paddock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trev's paddock — a 1-page Stardew-inspired 2D horse sim (PixiJS, static frontend).",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node tools/generate-sprites.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fmt": "biome check --write .",
    "test": "node --test --experimental-strip-types tests/sim.test.ts",
    "sprites": "node tools/generate-sprites.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
