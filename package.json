{
  "name": "trevs-paddock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trev's paddock — a 1-page Stardew-inspired 2D horse sim (PixiJS, static frontend).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "test": "node --test --experimental-strip-types tests/sim.test.ts",
    "sprites": "node tools/generate-sprites.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
